# Copy this file to .env and adjust for your environment.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to app code, and this
# is the ONLY configuration value the FoodNest mobile app needs — everything
# else (database URI, JWT secret) belongs solely in server/.env and must
# never be duplicated here.

# Local computer (iOS simulator / web):
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Android emulator (special host-loopback alias):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Physical Android device on the same Wi-Fi as your computer
# (replace with your computer's LAN IP — "localhost" on a phone means the
# phone itself, not your development machine):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:5000/api

# Deployed backend:
EXPO_PUBLIC_API_URL=https://YOUR-FOODNEST-BACKEND.onrender.com/api
